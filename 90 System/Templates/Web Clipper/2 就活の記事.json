      "type": "text"
    },
    {
      "name": "My initial thoughts",
      "value": "",
      "type": "text"
    },
    {
      "name": "URL",
      "value": "{{url}}",
      "type": "text"
    },
    {
      "name": "Author",
      "value": "{{author}}",
      "type": "text"
    },
    {
      "name": "Published",
      "value": "{{published}}",
      "type": "text"
    },
    {
      "name": "Captured",
      "value": "{{date}}",
      "type": "text"
