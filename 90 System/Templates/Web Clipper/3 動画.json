{
  "schemaVersion": "0.1.0",
  "name": "動画",
  "behavior": "create",
  "noteNameFormat": "{{title|safe_name}}",
  "path": "00 Inbox/Clips",
  "noteContentFormat": "# {{title}}\n\n## Raw content\n\n{{description}}\n\n(字幕・文字起こしがあれば、保存前にこの下に貼り付ける。なければリンクだけが保存され、整理の際に「原文が必要」として保留になることがある。)\n",
  "properties": [
    {
      "name": "資料の種類",
      "value": "動画",
      "type": "text"
    },
    {
      "name": "Why I saved this",
      "value": "デフォルト適用: AIなど新技術への関心で保存。就活期間は就活での活用の観点でも整理する。",
      "type": "text"
    },
    {
      "name": "My initial thoughts",
      "value": "",
      "type": "text"
    },
    {
      "name": "URL",
      "value": "{{url}}",
      "type": "text"
    },
    {
      "name": "Author",
      "value": "{{author}}",
      "type": "text"
    },
    {
      "name": "Published",
      "value": "{{published}}",
      "type": "text"
    },
    {
      "name": "Captured",
      "value": "{{date}}",
      "type": "text"
    },
    {
      "name": "処理状態",
      "value": "未処理",
      "type": "text"
    }
  ],
  "triggers": [
    "https://www.youtube.com/watch"
  ]
}
